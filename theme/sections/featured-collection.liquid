<div class="speedrule wrap" aria-hidden="true"><span class="sr-fill" data-pct="100"></span></div>

<section class="section picks" id="picks">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    <div class="pgrid" data-reveal-group>
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <div class="pgrid-empty" data-reveal>
          <p>Choose a collection in the theme editor to feature products here. Cabin-ready picks land as soon as the catalog opens.</p>
          <a class="btn btn-outline" href="{{ routes.all_products_collection_url }}">Browse all gear</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "shopify-section-picks",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "CABIN-READY PICKS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gear that keeps up."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
