{%- comment -%}
  not-found.liquid — themed 404 (keeps header/footer chrome).
{%- endcomment -%}

<section class="section not-found" data-reveal>
  <div class="wrap nf-inner">
    <p class="kicker">{{ section.settings.kicker | default: 'Error 404' }}<span class="streak-rule"></span></p>
    <h1>{{ section.settings.heading | default: 'This page slipped the stream.' }}</h1>
    <p class="nf-body">{{ section.settings.body | default: 'The page you were looking for is not here. Let us get you back on the road.' }}</p>
    <div class="hero-cta">
      <a class="btn btn-amber" href="{{ routes.all_products_collection_url }}">
        Shop all gear
        <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a class="btn btn-outline" href="{{ routes.search_url }}">Search</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404 not found",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Error 404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page slipped the stream." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The page you were looking for is not here. Let us get you back on the road." }
  ],
  "presets": [{ "name": "404 not found" }]
}
{% endschema %}
