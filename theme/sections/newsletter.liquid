<section class="section news">
  <div class="wrap news-inner" data-reveal>
    <div class="news-copy">
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.body != blank %}<p>{{ section.settings.body | escape }}</p>{% endif %}
    </div>
    {% form 'customer', class: 'news-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="vh" for="news-email-{{ section.id }}">{{ section.settings.input_label | default: 'Email address' | escape }}</label>
      <input id="news-email-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'you@example.com' | escape }}" required>
      <button class="btn btn-amber" type="submit">
        {{ section.settings.button_label | default: 'Sign up' | escape }}
        <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6"/></svg>
      </button>
      {% if form.posted_successfully? %}
        <p class="form-msg" aria-live="polite">{{ section.settings.success_msg | default: 'Thanks. Watch your inbox for the next drop.' | escape }}</p>
      {% elsif form.errors %}
        <p class="form-msg" aria-live="polite">{{ form.errors | default_errors }}</p>
      {% else %}
        <p class="form-msg">{{ section.settings.success_msg | default: 'Thanks. Watch your inbox for the next drop.' | escape }}</p>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "shopify-section-news",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New gear, before the rush."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Get road-tested drops and the occasional driver tip. No spam, unsubscribe anytime."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input label (screen reader)",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "success_msg",
      "label": "Success message",
      "default": "Thanks. Watch your inbox for the next drop."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
