{%- comment -%}
  main-page.liquid — generic fallback for any Shopify Page without a custom suffix.
  Renders the page title + admin-authored page.content inside theme chrome.
{%- endcomment -%}

<section class="section page-default" data-reveal>
  <div class="wrap page-narrow">
    {%- if section.settings.show_title -%}
      <div class="page-hero" data-reveal>
        <p class="kicker">{{ shop.name }}<span class="streak-rule"></span></p>
        <h1>{{ page.title }}</h1>
      </div>
    {%- endif -%}
    <div class="rte page-content">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true }
  ],
  "presets": [{ "name": "Page content" }]
}
{% endschema %}
