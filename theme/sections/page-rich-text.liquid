{%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.lede != blank -%}
  <section class="container" style="padding:40px 0 24px">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="page-h1" data-reveal>{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.lede != blank -%}
      <p class="page-lede" data-reveal>{{ section.settings.lede }}</p>
    {%- endif -%}
  </section>
{%- endif -%}

<section class="container prose" style="padding:8px 0 64px">
  <div data-reveal>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text page",
  "tag": "section",
  "class": "section-page-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "lede", "label": "Lede" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "text", "label": "Heading", "default": "Section heading" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your content here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text page",
      "blocks": [
        { "type": "heading", "settings": { "text": "Section heading" } },
        { "type": "text", "settings": { "text": "<p>Add your content here.</p>" } }
      ]
    }
  ]
}
{% endschema %}
