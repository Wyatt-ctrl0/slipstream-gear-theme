<section class="container" style="padding:40px 0 24px">
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h1 class="page-h1" data-reveal>{{ section.settings.heading | default: 'Frequently asked questions' }}</h1>
  {%- if section.settings.lede != blank -%}
    <p class="page-lede" data-reveal>{{ section.settings.lede }}</p>
  {%- endif -%}
</section>

<section class="container" style="padding:8px 0 64px">
  <div class="qa-list" data-reveal-group>
    {%- for block in section.blocks -%}
      {%- if block.type == 'qa' -%}
        <div class="qa" {{ block.shopify_attributes }}>
          <button class="qa-q" aria-expanded="false">{{ block.settings.question }}<span class="qa-ic" aria-hidden="true"></span></button>
          <div class="qa-a">{{ block.settings.answer }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ page",
  "tag": "section",
  "class": "section-page-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>Everything about shipping, returns, warranties, and the gear itself.</p>" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "When will my order ship?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders placed before 2pm ET ship the same business day. After that, they go out the next business day.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ page",
      "blocks": [
        { "type": "qa", "settings": { "question": "When will my order ship?", "answer": "<p>Orders placed before 2pm ET ship the same business day. After that, they go out the next business day.</p>" } },
        { "type": "qa", "settings": { "question": "Do you offer free shipping?", "answer": "<p>Yes. U.S. orders over $50 ship free. Under $50, a flat rate is calculated at checkout.</p>" } },
        { "type": "qa", "settings": { "question": "What's your return policy?", "answer": "<p>14-day returns on unused gear in original packaging. Start a return from your order confirmation email.</p>" } },
        { "type": "qa", "settings": { "question": "Are the specs accurate?", "answer": "<p>Yes. Every output rating, capacity, and dimension is measured by us, not copied from a supplier sheet.</p>" } },
        { "type": "qa", "settings": { "question": "How do I track my order?", "answer": "<p>You'll get a tracking link by email as soon as your order ships. No account needed.</p>" } },
        { "type": "qa", "settings": { "question": "Do products come with a warranty?", "answer": "<p>Most gear includes a 1-year limited warranty against defects. Check the product page for specifics.</p>" } }
      ]
    }
  ]
}
{% endschema %}
