{%- liquid
  assign logo_img = settings.logo_light
  assign logo_w = settings.logo_width | default: 180
-%}

<footer class="site-footer">
  <div class="wrap fgrid">
    <div class="fcol fbrand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {%- if logo_img != blank -%}
          {{ logo_img | image_url: width: 360 | image_tag: class: 'foot-logo', alt: shop.name, width: logo_w }}
        {%- else -%}
          <img src="{{ 'logo-lockup-light.png' | asset_url }}" alt="{{ shop.name | escape }}" class="foot-logo" width="{{ logo_w }}">
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p>{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- liquid
        assign has_social = false
        if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_facebook != blank
          assign has_social = true
        endif
      -%}
      {%- if has_social -%}
        <div class="fsocial">
          {%- if settings.social_instagram != blank -%}
            <a class="iconbtn" href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="1.2"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a class="iconbtn" href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v9.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4a4.5 4.5 0 0 0 4.5 4.5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a class="iconbtn" href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="M11 9.5l4 2.5-4 2.5z" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a class="iconbtn" href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7h2V4h-2.5A3.5 3.5 0 0 0 10 7.5V10H8v3h2v7h3v-7h2.2l.8-3H13V7.8c0-.5.3-.8.8-.8z" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <div class="fcol" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
          {%- if block.settings.link_list != blank and linklists[block.settings.link_list].links.size > 0 -%}
            {%- for link in linklists[block.settings.link_list].links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              {%- assign label_key = 'label_' | append: i -%}
              {%- assign url_key = 'url_' | append: i -%}
              {%- assign label = block.settings[label_key] -%}
              {%- assign url = block.settings[url_key] -%}
              {%- if label != blank -%}
                <a href="{{ url | default: '#' }}">{{ label }}</a>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="wrap fbar">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>Secure checkout. Powered by Shopify</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Clever gear for the daily driver. Organized, charged, road-tested."
    },
    {
      "type": "paragraph",
      "content": "Logo comes from Theme settings. Social icons appear automatically when their URLs are set in Theme settings."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop by need"
        },
        {
          "type": "link_list",
          "id": "link_list",
          "label": "Menu",
          "info": "Pick a navigation menu, or leave empty and use the manual links below."
        },
        {
          "type": "header",
          "content": "Manual links (used when no menu is selected)"
        },
        { "type": "text", "id": "label_1", "label": "Link 1 label" },
        { "type": "url", "id": "url_1", "label": "Link 1 URL" },
        { "type": "text", "id": "label_2", "label": "Link 2 label" },
        { "type": "url", "id": "url_2", "label": "Link 2 URL" },
        { "type": "text", "id": "label_3", "label": "Link 3 label" },
        { "type": "url", "id": "url_3", "label": "Link 3 URL" },
        { "type": "text", "id": "label_4", "label": "Link 4 label" },
        { "type": "url", "id": "url_4", "label": "Link 4 URL" },
        { "type": "text", "id": "label_5", "label": "Link 5 label" },
        { "type": "url", "id": "url_5", "label": "Link 5 URL" },
        { "type": "text", "id": "label_6", "label": "Link 6 label" },
        { "type": "url", "id": "url_6", "label": "Link 6 URL" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Shop by need",
            "label_1": "Tame the Mess", "url_1": "/collections/all",
            "label_2": "Clean & Detail", "url_2": "/collections/all",
            "label_3": "Charged & Connected", "url_3": "/collections/all",
            "label_4": "Road-Trip Ready", "url_4": "/collections/all"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Company",
            "label_1": "Our Story", "url_1": "/pages/about",
            "label_2": "Road-tested promise", "url_2": "/pages/about",
            "label_3": "FAQ", "url_3": "/pages/faq",
            "label_4": "Contact", "url_4": "/pages/contact",
            "label_5": "Shop All", "url_5": "/collections/all"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Help",
            "label_1": "Shipping", "url_1": "/pages/shipping-returns",
            "label_2": "14-day returns", "url_2": "/pages/shipping-returns",
            "label_3": "Wishlist", "url_3": "/pages/wishlist",
            "label_4": "Secure checkout", "url_4": "/pages/shipping-returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
