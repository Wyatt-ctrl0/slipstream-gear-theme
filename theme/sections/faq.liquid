<section class="section faq" id="faq">
  <div class="wrap faq-wrap">
    <div class="sec-head" data-reveal>
      {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    <div class="qa-list" data-reveal>
      {% for block in section.blocks %}
        {%- assign panel_id = 'qa-a-' | append: section.id | append: '-' | append: forloop.index -%}
        <div class="qa" {{ block.shopify_attributes }}>
          <button class="qa-q" aria-expanded="false" aria-controls="{{ panel_id }}">{{ block.settings.question | escape }}<span class="qa-ic" aria-hidden="true"></span></button>
          <div class="qa-a" id="{{ panel_id }}" hidden><p>{{ block.settings.answer | escape }}</p></div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "shopify-section-faq",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "QUESTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you load up."
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Does the mount fit my vents?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "The MagLock clips to most horizontal and vertical vent blades. The magnet plate sticks to any case or directly to the phone back."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "Does the mount fit my vents?", "answer": "The MagLock clips to most horizontal and vertical vent blades. The magnet plate sticks to any case or directly to the phone back." } },
        { "type": "qa", "settings": { "question": "How does free shipping work?", "answer": "Orders over $50 ship free within the U.S. Smaller orders show a flat rate at checkout before you pay." } },
        { "type": "qa", "settings": { "question": "What is the return window?", "answer": "You have 14 days from delivery to return an item. Start a return from your order email and we send return instructions." } },
        { "type": "qa", "settings": { "question": "What does road-tested mean?", "answer": "We drive each pick before it goes live. If it rattles, slips, or quits on the highway, it does not make the catalog." } }
      ]
    }
  ]
}
{% endschema %}
